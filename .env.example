# App connects to DB via Docker network (service name "db")
DATABASE_URL=postgres://youruser:yourpassword@db:5432/gradient_galore

# Postgres credentials (used by docker-compose for the db service)
POSTGRES_DB=gradient_galore
POSTGRES_USER=youruser
POSTGRES_PASSWORD=yourpassword

# Admin access for gallery moderation (optional — if unset, admin features are disabled)
ADMIN_SECRET=

# Custom domain (used by Coolify)
DOMAIN=https://your-domain.example.com
